# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo

# Logs and temp
*.log
*.tmp
*.bak

# Environment and local secrets
.env
.env.*
!.env.example
core/custom/define.php
!core/custom/define.php.example
core/custom/project-sources.local.md

# Dependency directories
vendor/
node_modules/

# Runtime cache
assets/cache/*
!assets/cache/.gitignore
core/cache/*
!core/cache/.gitignore

# Runtime import/export
assets/export/*
assets/import/*

# Keep deployable manager-side configs in git.
# Examples:
# assets/modules/clientsettings/config/
# assets/plugins/templatesedit/configs/
# assets/tvs/multitv/configs/
# assets/plugins/pagebuilder/config/
# assets/tvs/selector/lib/
# core/custom/directory/
